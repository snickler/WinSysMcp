<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <EnableWindowsApis>false</EnableWindowsApis>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))">
    <EnableWindowsApis>true</EnableWindowsApis>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">
    <EnableWindowsApis>true</EnableWindowsApis>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableWindowsApis)' == 'true'">
    <DefineConstants>$(DefineConstants);WINDOWS_APIS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5" />
    <PackageReference Include="coverlet.collector" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinSysMcp\WinSysMcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\tools\WinSysMcp.ToolSchemaGen\ToolSchemaGenerator.cs" Link="Shared\ToolSchemaGenerator.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableWindowsApis)' != 'true'">
    <Compile Remove="RegistryToolsTests.cs" />
  </ItemGroup>

</Project>
